{
  "name": "docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "workspaces": [
    "app"
  ],
  "scripts": {
    "check": "npm run content:check && npm run docs:check && npm run docs:build",
    "content:check": "node tools/check-content.mjs",
    "format": "prettier --write README.md package.json components pages tools",
    "format:check": "prettier --check README.md package.json components pages tools",
    "docs:check": "node tools/check-docs.mjs",
    "docs:dev": "node tools/docs.mjs dev",
    "docs:build": "node tools/docs.mjs build",
    "docs:preview": "node tools/docs.mjs preview",
    "pages:build": "node tools/pages.mjs"
  },
  "devDependencies": {
    "github-slugger": "^2.0.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2"
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": "^0.19.1"
    },
    "rehype-katex": {
      "katex": "^0.19.1"
    }
  },
  "allowScripts": {
    "fsevents": false
  }
}
