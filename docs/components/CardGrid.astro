---
// A grid of Card components: two columns by default, one on a phone.
import "./kit.css";

interface Props {
  columns?: 2 | 3;
}

const { columns = 2 } = Astro.props as Props;
---

<div class="kit-card-grid" data-columns={columns}>
  <slot />
</div>

<style>
  .kit-card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: var(--block-spacing-y) 0;
  }
  .kit-card-grid[data-columns="3"] {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  @media (max-width: 860px) {
    .kit-card-grid[data-columns="3"] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .kit-card-grid,
    .kit-card-grid[data-columns="3"] {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
