---
// A card that routes the reader: a title, a short text and, optionally, a link, the tint of a
// kind of page and an icon. Place cards in a CardGrid.
import { kindNamed } from "./kinds";
import { iconNamed } from "./icons";
import "./kit.css";

interface Props {
  title: string;
  href?: string;
  kind?: string;
  icon?: string;
}

const { title, href, kind: kindName, icon: iconName } = Astro.props as Props;
const kind = kindName ? kindNamed(kindName) : undefined;
const icon = iconName ? iconNamed(iconName) : undefined;
const Tag = href ? "a" : "div";
---

<Tag class="kit-card" href={href} data-kit-tint={kind?.key ?? "accent"}>
  {(icon || kind) && <span class="kit-card__head">
    {icon && <span class="kit-card__icon" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        set:html={icon}
      />
    </span>}
    {kind && <span class="kit-card__kind">{kind.label}</span>}
  </span>}
  <span class="kit-card__title">
    {title}
    {href && <span class="kit-card__arrow" aria-hidden="true"> → </span>}
  </span>
  <div class="kit-card__text"><slot /></div>
</Tag>

<style>
  .kit-card.kit-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    padding: 16px 18px 17px;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background: var(--page-bg);
    color: var(--text-color);
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }
  a.kit-card.kit-card:hover {
    border: 1px solid color-mix(in oklab, var(--kit-tint) 55%, transparent);
    background: var(--page-bg);
    color: var(--text-color);
    box-shadow: 0 6px 18px -10px color-mix(in oklab, var(--kit-tint) 60%, transparent);
    transform: translateY(-1px);
  }
  .kit-card .kit-card__head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 4px;
  }
  .kit-card .kit-card__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: var(--kit-wash);
    color: var(--kit-tint);
  }
  .kit-card .kit-card__icon svg {
    width: 19px;
    height: 19px;
  }
  .kit-card .kit-card__kind {
    color: var(--kit-tint);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .kit-card .kit-card__title {
    font-size: 16.5px;
    font-weight: 650;
    line-height: 1.3;
  }
  .kit-card .kit-card__arrow {
    display: inline-block;
    margin-left: 4px;
    color: var(--kit-tint);
    transition: transform 0.15s ease;
  }
  a.kit-card:hover .kit-card__arrow {
    transform: translateX(3px);
  }
  .kit-card .kit-card__text {
    color: var(--muted-color);
    font-size: 14.5px;
    line-height: 1.5;
  }
  .kit-card .kit-card__text :global(p) {
    margin: 0;
  }
  .kit-card .kit-card__text :global(p + p) {
    margin-top: 6px;
  }
  .kit-card .kit-card__text :global(code) {
    font-size: 0.9em;
  }
  @media (prefers-reduced-motion: reduce) {
    .kit-card.kit-card,
    .kit-card .kit-card__arrow {
      transition: none;
    }
    a.kit-card.kit-card:hover,
    a.kit-card:hover .kit-card__arrow {
      transform: none;
    }
  }
</style>
