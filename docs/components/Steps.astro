---
// A numbered procedure. Wrap a Markdown ordered list, with a blank line after the opening tag
// and before the closing one, and each item becomes a numbered step joined to the next.
import "./kit.css";
---

<div class="kit-steps" data-kit-tint="accent">
  <slot />
</div>

<style>
  .kit-steps {
    margin: var(--block-spacing-y) 0;
  }
  .kit-steps > :global(ol) {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: kit-step;
  }
  .kit-steps > :global(ol) > :global(li) {
    position: relative;
    margin: 0;
    padding: 0 0 24px 46px;
    counter-increment: kit-step;
  }
  .kit-steps > :global(ol) > :global(li:last-child) {
    padding-bottom: 0;
  }
  .kit-steps > :global(ol) > :global(li)::before {
    content: counter(kit-step);
    position: absolute;
    top: -1px;
    left: 0;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--kit-wash);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--kit-tint) 40%, transparent);
    color: var(--kit-tint);
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
  }
  .kit-steps > :global(ol) > :global(li)::after {
    content: "";
    position: absolute;
    top: 33px;
    bottom: 6px;
    left: 13.5px;
    width: 1px;
    background: var(--border-color);
  }
  .kit-steps > :global(ol) > :global(li:last-child)::after {
    display: none;
  }
  .kit-steps > :global(ol) > :global(li) > :global(*:last-child) {
    margin-bottom: 0;
  }
  /* The engine forces a margin under code blocks; a step's spacing replaces it. */
  .kit-steps > :global(ol) > :global(li) > :global(.code-card:last-child pre) {
    margin-bottom: 0 !important;
  }
</style>
